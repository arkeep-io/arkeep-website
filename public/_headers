# Read by Cloudflare Workers static assets; never served itself.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# Astro fingerprints everything under /_astro, so a file there never changes.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pages are served as plain text/html; name the charset in the header too, not only in <meta>.
# Every page URL ends in a slash (trailingSlash: 'always'), assets never do.
/
  Content-Type: text/html; charset=utf-8
/*/
  Content-Type: text/html; charset=utf-8
