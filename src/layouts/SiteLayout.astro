---
import '../styles/site.css';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import font400 from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-latin-400-normal.woff2?url';
import font600 from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-latin-600-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Keeps the page out of search results (the 404). */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={font400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={font600} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#fefbf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0806" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Same logic as Starlight's ThemeProvider, so both halves agree before first paint.
      (() => {
        let stored = null;
        try { stored = localStorage.getItem('starlight-theme'); } catch {}
        const theme = stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header" data-header><Nav /></header>
    <main id="main"><slot /></main>
    <Footer />
    <script>
      import '../scripts/reveal.ts';
      import '../scripts/github-live.ts';
      // A hairline under the sticky nav once the page has scrolled.
      const header = document.querySelector<HTMLElement>('[data-header]');
      const onScroll = () => header?.classList.toggle('scrolled', scrollY > 8);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: var(--gutter); top: -100px; z-index: 40; padding: var(--space-sm) var(--space-base); background: var(--ink); color: var(--canvas); border-radius: var(--radius-md); }
  .skip:focus { top: var(--space-sm); }
  .site-header {
    position: sticky; top: 0; z-index: 30; background: var(--canvas);
    border-bottom: 1px solid transparent; transition: border-color 200ms ease;
  }
  .site-header:global(.scrolled) { border-bottom-color: var(--hairline); }
</style>
