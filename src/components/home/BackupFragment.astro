---
// The Arkeep job page, rebuilt in HTML at true size so it can run a real (simulated) backup of this page.
// Markup mirrors the GUI's job detail view: sidebar, breadcrumb, summary cards, destinations, logs.
import { Image } from 'astro:assets';
import mark from '../../assets/arkeep-mark.png';
import Icon from '../site/Icon.astro';
import { backupLog, formatBytes, totalBytes } from '../../lib/snapshot';
import { HERO_DESTINATIONS, STATIC_FILES, STATIC_ID } from '../../lib/hero-job';

const staticLines = backupLog(STATIC_FILES, STATIC_ID, HERO_DESTINATIONS).flat();
const added = formatBytes(totalBytes(STATIC_FILES));
const times = ['11:54:50 AM', '11:54:50 AM', '11:54:50 AM', '11:54:52 AM', '11:54:52 AM', '11:54:55 AM', '11:54:55 AM'];
const nav = [
  { group: 'Overview', items: [{ icon: 'dashboard', label: 'Dashboard' }] },
  { group: 'Infrastructure', items: [{ icon: 'server', label: 'Agents' }, { icon: 'shield', label: 'Policies' }, { icon: 'drive', label: 'Destinations' }] },
  { group: 'Data', items: [{ icon: 'archive', label: 'Snapshots' }, { icon: 'clipboard', label: 'Jobs', active: true }] },
  { group: 'Operations', items: [{ icon: 'users', label: 'Users' }, { icon: 'settings', label: 'Settings' }] },
] as const;
---
<div class="app-frame"><div class="app" data-ui data-backup role="group" aria-label="Arkeep job page, running a backup of this website">
  <aside class="sidebar" aria-hidden="true">
    <div class="brand"><Image src={mark} alt="Arkeep" width={24} height={24} /><span>Arkeep</span></div>
    {nav.map((g) => (
      <div class="group">
        <p class="group-label">{g.group}</p>
        {g.items.map((it) => (
          <span class:list={['nav-item', { active: 'active' in it }]}><Icon name={it.icon} size={14} />{it.label}</span>
        ))}
      </div>
    ))}
    <div class="user"><span class="avatar">AR</span><span>Alex Rivera<small>alex@example.com</small></span></div>
  </aside>

  <div class="main">
    <div class="topbar" aria-hidden="true">
      <Icon name="sidebar" size={14} /><span class="sep"></span>
      <span class="crumb">Jobs</span><Icon name="chevron-right" size={12} /><span class="crumb current">Job Details</span>
      <span class="bell"><Icon name="bell" size={15} /></span>
    </div>

    <div class="content">
      <div class="title-row">
        <span class="back" aria-hidden="true"><Icon name="arrow-left" size={14} /></span>
        <div>
          <p class="title">Job Detail <span class="pill" data-status data-kind="ok"><Icon name="check-circle" size={12} /><span data-status-text>Succeeded</span></span></p>
          <p class="mono id" data-job-id>01a13a2f-5c0e-7d41-9b2e-{STATIC_ID}0000</p>
        </div>
        <span class="refresh" aria-hidden="true"><Icon name="refresh" size={14} /></span>
      </div>

      <div class="summary">
        <div class="cell"><p class="label">Policy</p><p class="value">arkeep.io</p></div>
        <div class="cell"><p class="label">Agent</p><p class="value">web-01</p></div>
        <div class="cell"><p class="label">Snapshot</p><p class="value mono" data-readout>{STATIC_ID} · {STATIC_FILES.length} files · {added}</p></div>
      </div>

      <p class="section-label">Destinations</p>
      <table class="dests">
        <thead><tr><th>Destination</th><th>Status</th><th class="num">Added</th><th class="num hide-narrow">Duration</th></tr></thead>
        <tbody>
          {HERO_DESTINATIONS.map((d, i) => (
            <tr data-dest={i}>
              <td>{d.name}</td>
              <td><span class="pill" data-kind="ok"><Icon name="check-circle" size={12} /><span>Succeeded</span></span></td>
              <td class="num mono" data-added>{added}</td>
              <td class="num mono hide-narrow" data-duration>{i === 0 ? '2s' : '3s'}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <p class="section-label">Logs</p>
      <div class="logs mono" data-log tabindex="0" role="log" aria-label="Job log" translate="no">
        {staticLines.map((l, i) => (
          <p><span class="t">{times[i] ?? times.at(-1)}</span><span class="lvl">{l.level}</span><span class="msg">{l.msg}</span></p>
        ))}
      </div>
    </div>
  </div>
</div></div>

<style>
  /* Interface sizes are the GUI's own (13–15px), not the site's type scale. */
  /* The frame is the query container: an element cannot query its own width. */
  .app-frame { container-type: inline-size; height: 100%; }
  .app {
    display: grid; grid-template-columns: 188px minmax(0, 1fr);
    height: 100%; background: var(--canvas-soft); color: var(--ink);
    font-size: 13px; line-height: 1.45; text-align: left;
  }
  .mono { font-family: var(--font-mono); }

  .sidebar { display: flex; flex-direction: column; gap: 14px; padding: 14px 10px; }
  .brand { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 14px; padding: 0 6px 4px; }
  .brand img { width: 24px; height: 24px; border-radius: 6px; }
  .group { display: grid; gap: 2px; }
  .group-label { font-size: 11px; color: var(--body); padding: 0 6px 2px; }
  .nav-item { display: flex; align-items: center; gap: 8px; padding: 5px 6px; border-radius: 6px; font-size: 13px; }
  .nav-item.active { background: var(--accent-soft); color: var(--on-accent-soft); }
  .user { margin-top: auto; display: flex; align-items: center; gap: 8px; padding: 6px; font-size: 12px; }
  .user small { display: block; color: var(--body); font-size: 11px; }
  .avatar { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 6px; background: var(--hairline-soft); font-size: 11px; font-weight: 600; }

  .main {
    display: flex; flex-direction: column; min-width: 0; margin: 8px 8px 8px 0;
    background: var(--canvas); border: 1px solid var(--hairline); border-radius: 10px; overflow: hidden;
  }
  .topbar { display: flex; align-items: center; gap: 8px; height: 40px; padding: 0 14px; border-bottom: 1px solid var(--hairline); flex: none; }
  .sep { width: 1px; height: 14px; background: var(--hairline-strong); margin: 0 4px; }
  .crumb { color: var(--body); }
  .crumb.current { color: var(--ink); }
  .bell { margin-left: auto; }

  .content { padding: 16px 18px 14px; display: flex; flex-direction: column; gap: 10px; min-height: 0; flex: 1; }
  .title-row { display: flex; align-items: flex-start; gap: 10px; }
  .back { padding-top: 6px; }
  .title { display: flex; align-items: center; gap: 8px; font-size: 19px; font-weight: 600; letter-spacing: -0.01em; }
  .id { font-size: 11px; color: var(--body); }
  .refresh { margin-left: auto; display: grid; place-items: center; width: 28px; height: 28px; border: 1px solid var(--hairline-strong); border-radius: 6px; background: var(--surface-card); }

  .summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .cell { background: var(--surface-card); border: 1px solid var(--hairline-strong); border-radius: 8px; padding: 8px 10px; min-width: 0; }
  .label { font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--body); }
  .value { font-size: 13px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .value.mono { font-size: 12px; font-variant-numeric: tabular-nums; }
  .section-label { font-size: 13px; font-weight: 500; margin-top: 2px; }

  .dests { width: 100%; border-collapse: separate; border-spacing: 0; background: var(--surface-card); border: 1px solid var(--hairline-strong); border-radius: 8px; }
  .dests th { text-align: left; font-weight: 500; padding: 7px 10px; border-bottom: 1px solid var(--hairline); }
  .dests td { padding: 6px 10px; border-top: 1px solid var(--hairline); white-space: nowrap; }
  .dests tr:first-child td { border-top: 0; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .dests th.num { text-align: right; }

  .pill {
    display: inline-flex; align-items: center; gap: 4px; padding: 1px 8px; border-radius: 999px;
    font-size: 12px; font-weight: 500; line-height: 1.5; border: 1px solid transparent;
  }
  .title .pill { font-size: 12px; }
  .pill[data-kind='ok'] { background: var(--success-soft); color: var(--success); border-color: color-mix(in srgb, var(--success) 25%, transparent); }
  .pill[data-kind='running'] { background: var(--accent-soft); color: var(--on-accent-soft); }
  .pill[data-kind='running'] :global(svg) { animation: spin 1s linear infinite; }
  .pill[data-kind='pending'] { background: var(--hairline-soft); color: var(--body); }
  .pill[data-kind='broken'] { background: color-mix(in srgb, var(--error) 12%, transparent); color: var(--error); }
  @keyframes spin { to { transform: rotate(360deg); } }

  .logs {
    flex: 1; min-height: 96px; overflow: auto; padding: 8px 10px;
    background: var(--surface-card); border: 1px solid var(--hairline-strong); border-radius: 8px;
    font-size: 11.5px; line-height: 1.7;
  }
  .logs :global(p) { display: flex; gap: 10px; white-space: nowrap; }
  .logs :global(.t) { color: var(--body); flex: none; }
  .logs :global(.lvl) { flex: none; padding: 0 5px; border-radius: 4px; background: var(--hairline-soft); font-size: 10px; line-height: 1.9; align-self: center; }
  .logs :global(.msg) { overflow: hidden; text-overflow: ellipsis; }

  /* Narrow screens (tablet laptop, phone frame): the GUI's own collapsed layout. */
  @container (max-width: 720px) {
    .app { grid-template-columns: minmax(0, 1fr); }
    .sidebar { display: none; }
    .main { margin: 0; border: 0; border-radius: 0; }
  }
  @container (max-width: 460px) {
    .summary { grid-template-columns: 1fr 1fr; }
    .summary .cell:last-child { grid-column: span 2; }
    .hide-narrow { display: none; }
    .content { padding: 12px; }
    .logs :global(p) { flex-wrap: wrap; gap: 0 8px; white-space: normal; }
    .logs :global(.msg) { flex-basis: 100%; overflow: visible; white-space: normal; word-break: break-word; }
    .back { display: none; }
  }
</style>
