---
import BackupFragment from './BackupFragment.astro';
import NewTabIcon from '../site/NewTabIcon.astro';
import { GET_STARTED_URL, GITHUB_URL, NEW_TAB } from '../site/links';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="copy-half">
    <div class="hero-copy" data-snapshot="hero">
      <h1 id="hero-title">
        <span class="line"><span>Backups you can</span></span>
        <span class="line"><span>actually restore</span></span>
      </h1>
      <p>Open-source, self-hosted control for Restic and Rclone: one server, a lightweight agent on every machine, one dashboard.</p>
      <div class="actions">
        <a class="button button--lg" href={GET_STARTED_URL} {...NEW_TAB}>Install Arkeep<NewTabIcon /></a>
        <a class="text-link" href={GITHUB_URL} {...NEW_TAB}>Star on GitHub</a>
      </div>
    </div>
  </div>
  <div class="fragment-half">
    <BackupFragment />
    <p class="caption">Try it: back up this page, break it, restore it.</p>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: min(calc(100svh - 72px), 880px);
  }
  .copy-half {
    background: var(--canvas);
    padding: clamp(48px, 10vh, 120px) var(--margin) var(--space-9) max(var(--margin), calc((100vw - 1360px) / 2 + var(--margin)));
  }
  .fragment-half {
    background: var(--surface-strong);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-4);
    padding: var(--space-8) var(--margin);
  }
  h1 {
    font-size: clamp(2.25rem, 4.6vw, 4.75rem);
    letter-spacing: -0.04em;
    line-height: 0.98;
  }
  .line { display: block; overflow: clip; padding-bottom: 0.06em; }
  .line > span { display: block; }
  /* Signature move: each headline line rises from behind its own baseline. */
  :global(.js) .hero-copy .line > span { transform: translateY(105%); animation: rise 900ms cubic-bezier(0.16, 1, 0.3, 1) 120ms forwards; }
  :global(.js) .hero-copy .line:nth-child(2) > span { animation-delay: 230ms; }
  :global(.js) .hero-copy > p,
  :global(.js) .hero-copy > .actions { opacity: 0; animation: fade 600ms ease 560ms forwards; }
  @keyframes rise { to { transform: none; } }
  @keyframes fade { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hero-copy .line > span,
    :global(.js) .hero-copy > p,
    :global(.js) .hero-copy > .actions { animation: none; transform: none; opacity: 1; }
  }
  .hero-copy p {
    margin-top: var(--space-6);
    font-size: var(--step-lead);
    line-height: 1.4;
    max-width: 30ch;
  }
  .actions { margin-top: var(--space-7); display: flex; align-items: center; gap: var(--space-6); flex-wrap: wrap; }
  .button--lg { min-height: 52px; padding: 0 var(--space-6); font-size: var(--step-body); }
  .caption { font-size: var(--step-small); color: var(--muted); }
  .hero :global(.missing) { font-size: var(--step-lead); font-weight: 500; color: var(--error); }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .fragment-half { padding: var(--space-7) 20px var(--space-8); }
    .copy-half { padding: var(--space-7) 20px var(--space-8); }
    h1 { font-size: clamp(2rem, 8.6vw, 3.75rem); }
  }
</style>
