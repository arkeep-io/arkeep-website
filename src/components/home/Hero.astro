---
import { Image } from 'astro:assets';
import BackupFragment from './BackupFragment.astro';
import NewTabIcon from '../site/NewTabIcon.astro';
import Icon from '../site/Icon.astro';
import { GET_STARTED_URL, GITHUB_URL, newTab, RELEASES_URL } from '../site/links';
import { latestRelease } from '../../lib/github-build';
import phoneLight from '../../assets/screens/mobile-dashboard-light.png';
import phoneDark from '../../assets/screens/mobile-dashboard-dark.png';

const release = await latestRelease();
---
<section class="hero" aria-labelledby="hero-title">
  <canvas class="backdrop" data-backdrop aria-hidden="true"></canvas>
  <div class="wrap copy-wrap">
    <div class="hero-copy" data-snapshot="hero">
      <a class="release" href={release?.url ?? RELEASES_URL} {...newTab()} data-gh-release-link>
        <span class="badge badge--accent" data-gh-release-tag>{release ? release.tag : 'Open source'}</span>
        <span data-gh-release-label>{release ? 'Latest release' : 'Apache-2.0'}</span>
        <Icon name="chevron-right" size={14} />
      </a>
      <h1 id="hero-title" class="display-mega">
        <!-- Arkeep's first commit message (b00a7de, 2026-02-20). -->
        <span class="line"><span>Let there be</span></span>{' '}
        <span class="line"><span>backups</span></span>
      </h1>
      <p class="lead">Open-source, self-hosted control for Restic and Rclone: one server, a lightweight agent on every machine, one dashboard.</p>
      <div class="actions">
        <a class="button button--lg" href={GET_STARTED_URL} {...newTab()}>Install Arkeep<NewTabIcon /></a>
        <a class="button button--lg button--secondary" href={GITHUB_URL} {...newTab()}><Icon name="github" />Star on GitHub</a>
      </div>
    </div>
  </div>

  <div class="stage">
    <div class="wash" aria-hidden="true"></div>
    <div class="devices">
      <div class="laptop">
        <div class="lid"><div class="screen"><BackupFragment /></div></div>
        <div class="base" aria-hidden="true"><span class="notch"></span></div>
      </div>
      <div class="phone" aria-hidden="true">
        <div class="phone-screen">
          <Image src={phoneLight} alt="" width={204} densities={[1, 2, 3]} quality={90} data-theme-img="light" loading="eager" />
          <Image src={phoneDark} alt="" width={204} densities={[1, 2, 3]} quality={90} data-theme-img="dark" loading="eager" />
        </div>
      </div>
    </div>

    <div class="wrap">
      <div class="try" data-try>
        <p class="try-label">Try it on this page</p>
        <ol class="steps">
          <li><button class="button" type="button" data-run><Icon name="play" />Run backup</button></li>
          <li><button class="button button--secondary" type="button" data-break disabled><Icon name="scissors" />Break the headline</button></li>
        </ol>
        <p class="try-note" data-try-note aria-live="polite">The job backs up this page’s sections to two destinations.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; padding-top: clamp(48px, 8vw, 96px); text-align: center; overflow-x: clip; }
  /* Snapshot-cell field behind the copy (scripts/hero-backdrop.ts). It fades out towards the edges and
     well before the section ends, so nothing is cut off by the next section. */
  .backdrop {
    position: absolute; inset: 0 0 auto; height: min(100%, 1100px); width: 100%; z-index: -2; pointer-events: none;
    -webkit-mask-image: radial-gradient(70% 60% at 50% 22%, #000 0%, rgba(0, 0, 0, 0.55) 45%, transparent 80%);
    mask-image: radial-gradient(70% 60% at 50% 22%, #000 0%, rgba(0, 0, 0, 0.55) 45%, transparent 80%);
  }
  .hero-copy { display: grid; justify-items: center; }
  .release {
    display: inline-flex; align-items: center; gap: 10px; padding: 4px 10px 4px 4px; margin-bottom: var(--space-lg);
    border: 1px solid var(--hairline-strong); border-radius: var(--radius-pill); background: var(--surface-card);
    font-size: 13px; color: var(--body); text-decoration: none; transition: border-color 160ms ease, color 160ms ease;
  }
  .release:hover { border-color: var(--muted); color: var(--ink); }
  .release .badge { letter-spacing: 0.02em; text-transform: none; font-size: 12px; }
  h1 { white-space: nowrap; }
  @media (max-width: 400px) { h1 { white-space: normal; } }
  .line { display: block; overflow: clip; padding-bottom: 0.06em; }
  .line > span { display: block; }
  /* Signature move: each headline line rises from behind its own baseline. */
  :global(.js) .hero-copy .line > span { transform: translateY(105%); animation: rise 900ms cubic-bezier(0.16, 1, 0.3, 1) 120ms forwards; }
  :global(.js) .hero-copy .line:nth-child(2) > span { animation-delay: 230ms; }
  :global(.js) .hero-copy > .lead,
  :global(.js) .hero-copy > .actions,
  :global(.js) .hero-copy > .release { opacity: 0; animation: fade 600ms ease 520ms forwards; }
  @keyframes rise { to { transform: none; } }
  @keyframes fade { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hero-copy .line > span,
    :global(.js) .hero-copy > * { animation: none; transform: none; opacity: 1; }
  }
  .lead { margin-top: var(--space-lg); max-width: 50ch; font-size: 1.125rem; line-height: 1.55; color: var(--body); }
  .actions { margin-top: var(--space-xl); display: flex; justify-content: center; gap: var(--space-sm); flex-wrap: wrap; }
  /* What "Break the headline" leaves behind: a gap with the way back. */
  .hero :global(.missing) {
    display: grid; place-content: center; justify-items: center; gap: var(--space-base); min-height: inherit; padding: var(--space-lg);
    border: 2px dashed var(--error); border-radius: var(--radius-lg); background: color-mix(in srgb, var(--canvas) 85%, transparent);
  }
  .hero :global(.missing p) { color: var(--error); font-weight: 500; }

  /* Device composite over the warm wash (DESIGN.md › hero-band, device-mockup-card). */
  .stage { position: relative; margin-top: clamp(48px, 6vw, 72px); padding-bottom: var(--space-xl); }
  .wash {
    position: absolute; inset: 10% 0 0; z-index: -1; pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent 92%);
    mask-image: linear-gradient(to bottom, #000 45%, transparent 92%);
    background:
      radial-gradient(60% 55% at 50% 45%, var(--gradient-warm-mid) 0%, transparent 70%),
      radial-gradient(80% 70% at 50% 60%, var(--gradient-warm-light) 0%, transparent 75%);
  }
  .devices { position: relative; width: min(100% - 2 * var(--gutter), 1080px); margin-inline: auto; padding-right: 60px; }
  .laptop { position: relative; }
  .lid {
    padding: 14px 14px 18px; border-radius: 20px 20px 6px 6px;
    background: #1d1714; box-shadow: var(--shadow-device), inset 0 0 0 1px #3a312c;
  }
  .screen { aspect-ratio: 16 / 10; border-radius: 6px; overflow: hidden; background: var(--canvas); }
  .base {
    position: relative; height: 18px; margin-inline: -5%;
    border-radius: 2px 2px 18px 18px; background: linear-gradient(#cfc6c0, #a79e98);
  }
  :global([data-theme='dark']) .base { background: linear-gradient(#4a413c, #2a221e); }
  .notch { position: absolute; left: 50%; top: 0; width: 120px; height: 7px; transform: translateX(-50%); border-radius: 0 0 8px 8px; background: rgba(0, 0, 0, 0.18); }

  .phone {
    position: absolute; right: 0; bottom: -28px; width: 220px; padding: 8px;
    border-radius: 34px; background: #1d1714; box-shadow: var(--shadow-device), inset 0 0 0 1px #3a312c;
  }
  .phone-screen { position: relative; aspect-ratio: 390 / 844; border-radius: 28px; overflow: hidden; background: var(--canvas); }
  .phone-screen img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  [data-theme-img='dark'] { display: none; }
  :global([data-theme='dark']) [data-theme-img='light'] { display: none; }
  :global([data-theme='dark']) [data-theme-img='dark'] { display: block; }

  .try { margin: var(--space-xxl) auto 0; display: grid; justify-items: center; gap: var(--space-sm); }
  .try-label { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--body); }
  .steps { display: none; list-style: none; margin: 0; padding: 0; gap: var(--space-xs); flex-wrap: wrap; justify-content: center; }
  :global(.js) .steps { display: flex; }
  :global(html:not(.js)) .try-label { display: none; }
  .try-note { font-size: 14px; color: var(--body); min-height: 1.5em; }

  @media (max-width: 1023px) {
    .devices { padding-right: 0; }
    .phone { display: none; }
  }
  /* Phones: the laptop becomes a single phone frame holding the live job page (DESIGN.md › collapsing). */
  @media (max-width: 639px) {
    .devices { width: min(100% - 2 * var(--gutter), 360px); }
    .lid { padding: 8px; border-radius: 40px; }
    .screen { aspect-ratio: auto; height: 600px; border-radius: 32px; }
    .base { display: none; }
    .steps { flex-direction: column; align-items: stretch; width: 100%; max-width: 360px; }
    .steps .button { width: 100%; min-height: 44px; }
    .try { margin-top: var(--space-xl); }
  }
</style>

<script>
  import '../../scripts/backup-fragment.ts';
  import '../../scripts/hero-backdrop.ts';
</script>
