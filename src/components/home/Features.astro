---
import { Image } from 'astro:assets';
import ScreenCrop from './ScreenCrop.astro';
import poster from '../../assets/screens/job-log-poster.png';
---
<section id="features" class="features wrap" data-snapshot="features" aria-labelledby="features-title">
  <h2 id="features-title" data-reveal>Built for real servers</h2>
  <div class="grid">
    <article data-cell class="text-top" data-reveal style="--i: 0">
      <div class="text">
        <h3>Docker volumes, discovered</h3>
        <p>Arkeep finds containers and volumes on each host and adapts when services come and go, without restarts.</p>
      </div>
      <div class="frag">
        <div class="ui-card" data-ui>
          <p class="ui-head">Add source · <span>web-01</span></p>
          <ul class="volumes">
            <li><span class="box checked" aria-hidden="true"></span>postgres_data<span class="meta">postgres:16</span></li>
            <li><span class="box checked" aria-hidden="true"></span>nextcloud_html<span class="meta">nextcloud:29</span></li>
            <li><span class="box" aria-hidden="true"></span>gitea_data<span class="meta">gitea:1.22</span></li>
            <li><span class="box" aria-hidden="true"></span>traefik_certs<span class="meta">traefik:3.1</span></li>
          </ul>
        </div>
      </div>
    </article>

    <article data-cell class="frag-top" data-reveal style="--i: 1">
      <div class="text">
        <h3>Databases straight into restic</h3>
        <p>Stream <code translate="no">pg_dump</code> or <code translate="no">mysqldump</code> into restic with a command source. No temp files on disk.</p>
      </div>
      <div class="frag">
        <div class="ui-card" data-ui>
          <p class="ui-head">Sources · Postgres</p>
          <table>
            <thead><tr><th>Type</th><th>Command</th><th>Mode</th></tr></thead>
            <tbody>
              <tr><td>command</td><td><code translate="no">pg_dump -U app appdb</code></td><td>stdin</td></tr>
              <tr><td>directory</td><td><code translate="no">/etc/postgresql</code></td><td>files</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </article>

    <article data-cell class="frag-top" data-reveal style="--i: 2">
      <div class="text">
        <h3>One policy, many destinations</h3>
        <p>Apply 3-2-1 with several destinations per policy, each with its own retention.</p>
      </div>
      <div class="frag"><ScreenCrop name="policy" crop={{ x: 836, y: 250, w: 600, h: 200 }} alt="Arkeep policy page listing two destinations, NAS (local) and Offsite copy" /></div>
    </article>

    <article data-cell class="text-top" data-reveal style="--i: 3">
      <div class="text">
        <h3>Browse a snapshot, restore a file</h3>
        <p>Open any snapshot, walk its folders, download a file or restore a selection.</p>
      </div>
      <div class="frag"><ScreenCrop name="snapshot-browse" crop={{ x: 272, y: 244, w: 600, h: 300 }} alt="Arkeep snapshot browser showing the folders and files of a Postgres snapshot" /></div>
    </article>

    <article data-cell class="text-top" data-reveal style="--i: 4">
      <div class="text">
        <h3>Know when it fails</h3>
        <p>Email, signed webhooks and Healthchecks.io pings on success or failure, and live progress while restic runs.</p>
      </div>
      <div class="frag video" data-ui>
        <div class="video-crop">
        <video muted loop playsinline preload="none" translate="no" poster={poster.src} width="1200" height="750" data-autoplay aria-label="A running backup job in the Arkeep interface, its destinations finishing one by one">
          <source src="/media/job-log-loop.webm" type="video/webm" />
        </video>
        <button type="button" class="video-toggle" data-video-toggle aria-label="Pause video" hidden>Pause</button>
        </div>
      </div>
    </article>

    <article data-cell class="frag-top" data-reveal style="--i: 5">
      <div class="text">
        <h3>Your login, your rules</h3>
        <p>OIDC with Keycloak, Authentik or Zitadel, TOTP two-factor, and read-only users.</p>
      </div>
      <div class="frag"><ScreenCrop name="security" crop={{ x: 268, y: 620, w: 620, h: 150 }} alt="Arkeep profile page with the option to enable two-factor authentication" /></div>
    </article>
  </div>
</section>

<style>
  .features { margin-top: var(--section-gap); }
  h2 { font-size: var(--step-h2); margin-bottom: 56px; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  article {
    --reveal-delay: calc(var(--i) * 70ms);
    min-height: 460px; display: flex; flex-direction: column;
    background: var(--surface-muted); border-radius: var(--radius-lg); overflow: hidden;
  }
  /* Checkerboard on two columns: text-top / fragment-top, then the reverse, then again. */
  .frag-top { flex-direction: column-reverse; }
  .text { padding: var(--space-6); display: grid; gap: var(--space-2); }
  h3 { font-size: var(--step-lead); font-weight: 500; letter-spacing: -0.015em; line-height: 1.25; }
  .text p { font-size: var(--step-body); line-height: 1.5; }
  .text code { font-size: 0.9em; }
  /* The fragment docks to the cell edge opposite the text and is cropped by the cell. */
  .frag { flex: 1; display: flex; align-items: flex-end; margin-left: var(--space-6); min-height: 180px; }
  .frag-top .frag { align-items: flex-start; }
  .frag > * { background: var(--surface-card); border-top-left-radius: var(--radius-md); overflow: hidden; }
  .frag-top .frag > * { border-top-left-radius: 0; border-bottom-left-radius: var(--radius-md); }
  .ui-card { flex: 1; align-self: stretch; padding: var(--space-5); font-size: 14px; display: grid; gap: var(--space-3); align-content: start; width: 100%; }
  .ui-head { font-weight: 600; font-size: 14px; }
  .ui-head span { color: var(--muted); font-weight: 400; }
  .volumes { list-style: none; margin: 0; padding: 0; display: grid; }
  .volumes li { display: flex; align-items: center; gap: var(--space-3); padding: 10px 0; border-top: 1px solid var(--hairline); } /* taste-skill-ignore: row divider inside a product fragment (data-ui) */
  .volumes .meta { margin-left: auto; color: var(--muted); font-size: 13px; }
  .box { width: 16px; height: 16px; border: 1px solid var(--hairline-strong); border-radius: 4px; flex: none; }
  .box.checked { background: var(--brand); border-color: var(--brand); box-shadow: inset 0 0 0 3px var(--surface-card); } /* taste-skill-ignore: checked checkbox ring inside a product fragment (data-ui) */
  table { width: 100%; border-collapse: collapse; }
  th { text-align: left; color: var(--muted); font-weight: 500; font-size: 13px; padding-bottom: var(--space-2); }
  td { padding: 10px var(--space-3) 10px 0; border-top: 1px solid var(--hairline); white-space: nowrap; }
  td code { font-size: 13px; }
  /* Same crop math as ScreenCrop, for the 1200×750 recording: x 270, y 290, 600×330. */
  .video-toggle {
    position: absolute; right: var(--space-3); bottom: var(--space-3); z-index: 1; min-height: 32px; padding: 0 var(--space-3);
    border: 0; border-radius: var(--radius-md); background: var(--surface-dark-elevated); color: var(--on-dark); font-size: 13px; cursor: pointer;
    transition: background-color 160ms ease;
  }
  .video-toggle:hover { background: var(--surface-strong); color: var(--ink); }
  .video-crop { position: relative; overflow: hidden; width: 100%; aspect-ratio: 600 / 330; background: var(--surface-dark); }
  .video video { position: absolute; max-width: none; width: calc(1200 / 600 * 100%); height: auto; left: calc(-270 / 600 * 100%); top: calc(-290 / 330 * 100%); }

  @media (max-width: 700px) {
    .grid { grid-template-columns: 1fr; gap: 6px; }
    article, .frag-top { min-height: 0; flex-direction: column; }
    .frag, .frag-top .frag { min-height: 220px; border-radius: 0; border-top-left-radius: var(--radius-md); }
    article:nth-child(even) .frag { margin-left: 0; margin-right: var(--space-6); justify-content: flex-end; }
    .frag { overflow: hidden; }
    .video-crop { width: 600px; flex: none; }
  }
</style>

<script>
  // Autoplay only when motion is welcome; otherwise the poster stands in.
  const video = document.querySelector<HTMLVideoElement>('#features video[data-autoplay]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-video-toggle]');
  if (video && toggle && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let paused = false; // the visitor's choice wins over scrolling
    const label = () => {
      toggle.textContent = video.paused ? 'Play' : 'Pause';
      toggle.setAttribute('aria-label', video.paused ? 'Play video' : 'Pause video');
    };
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      paused = !video.paused;
      if (paused) video.pause();
      else void video.play().catch(() => {});
    });
    video.addEventListener('play', label);
    video.addEventListener('pause', label);
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting && !paused) void video.play().catch(() => {});
        else if (!e.isIntersecting) video.pause();
      }
    });
    io.observe(video);
  }
</script>
