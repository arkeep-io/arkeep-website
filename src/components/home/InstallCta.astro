---
import NewTabIcon from '../site/NewTabIcon.astro';
import Icon from '../site/Icon.astro';
import { NEW_TAB } from '../site/links';
import { installTargets } from '../../lib/install';
const first = installTargets[0];
---
<section id="install" class="section install" data-snapshot="install" aria-labelledby="install-title">
  <div class="wrap">
    <div class="band" data-install>
      <div class="section-head" data-reveal>
        <h2 id="install-title" class="display-lg">Back up your first server tonight</h2>
        <p>Pick where Arkeep runs. Every command below comes from the install guide.</p>
      </div>

      <div class="console" data-reveal style="--reveal-delay: 90ms">
        <div class="platforms" role="radiogroup" aria-label="Platform">
          {installTargets.map((t, i) => (
            <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-platform={t.id}>{t.label}</button>
          ))}
        </div>
        <div class="command">
          <div class="command-bar">
            <span>Terminal</span>
            <button type="button" class="copy" data-copy><Icon name="copy" /><span data-copy-label>Copy</span></button>
            <span class="visually-hidden" data-copy-status aria-live="polite"></span>
          </div>
          <pre translate="no"><code data-install-command>{first.command}</code></pre>
        </div>
        <div class="actions">
          <a class="button button--lg" href={first.href} {...NEW_TAB} data-install-link><span>Open the <span data-install-label>{first.label}</span> guide</span><NewTabIcon /></a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .band { padding: clamp(48px, 7vw, 96px) 0; }
  .console { max-width: 760px; margin-inline: auto; display: grid; gap: var(--space-base); justify-items: center; }
  .platforms { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 4px; padding: 4px; background: var(--hairline-soft); border-radius: var(--radius-md); }
  .platforms button {
    min-height: 36px; padding: 0 var(--space-base); border: 0; border-radius: var(--radius-sm);
    background: transparent; color: var(--body); font-size: 14px; font-weight: 500; cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .platforms button:hover { color: var(--ink); }
  .platforms button[aria-checked='true'] { background: var(--surface-card); color: var(--ink); box-shadow: 0 1px 2px rgba(23, 16, 12, 0.08); }
  /* DESIGN.md › code-block, with a bar for the copy action so it never covers the command. */
  .command { width: 100%; border-radius: var(--radius-lg); overflow: hidden; background: var(--surface-dark); color: var(--on-dark); text-align: left; }
  :global([data-theme='dark']) .command { border: 1px solid var(--hairline); }
  .command-bar { display: flex; align-items: center; justify-content: space-between; min-height: 44px; padding: 0 var(--space-xs) 0 var(--space-md); background: var(--surface-dark-elevated); font-size: 12px; color: var(--on-dark-soft); }
  .command pre { margin: 0; padding: var(--space-md); min-height: 88px; font-size: 13px; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
  .copy {
    display: inline-flex; align-items: center; gap: 6px;
    min-height: 32px; padding: 0 var(--space-sm); border: 1px solid #3a312c; border-radius: var(--radius-md);
    background: #201915; color: #ece7e3; font-size: 13px; cursor: pointer; transition: background-color 160ms ease;
  }
  .copy:hover { background: #2a221e; }
  .copy svg { width: 14px; height: 14px; }
  .actions { margin-top: var(--space-xs); }
  @media (max-width: 639px) {
    .platforms { display: grid; grid-template-columns: 1fr 1fr; width: 100%; }
    .platforms button { min-height: 44px; }
    .command pre { font-size: 12px; }
    .actions, .actions .button { width: 100%; }
  }
</style>

<script>
  import '../../scripts/install-cta.ts';
</script>
