---
const steps = [
  { title: 'Start the server.', body: 'One container or one binary. SQLite by default, PostgreSQL when you want it.' },
  { title: 'Then enroll an agent on each machine.', body: 'The agent dials out over gRPC with mTLS. No inbound port, works behind NAT.' },
  { title: 'Policies run everywhere, on schedule.', body: 'Progress streams back live while restic runs, logs land when it finishes.' },
];
const agents = [
  { name: 'web-01', os: 'linux / amd64' },
  { name: 'db-01', os: 'linux / amd64' },
  { name: 'nas-01', os: 'linux / arm64' },
  { name: 'pi-backup', os: 'linux / arm' },
];
---
<section id="how-it-works" class="how wrap" data-snapshot="how-it-works" aria-labelledby="how-title">
  <h2 id="how-title" data-reveal>Nothing to open</h2>
  <div class="statements">
    {steps.map((s, i) => (
      <article data-step={i} class:list={{ 'is-active': i === 0 }}>
        <h3>{s.title}</h3>
        <p>{s.body}</p>
      </article>
    ))}
  </div>

  <div class="stage-wrap">
    <div class="stage" data-stage data-state="0">
      <div class="agents" data-ui>
        <div class="layer" data-layer="0">
          <div class="bar"><span class="title">Agents</span><span class="meta">0 online</span></div>
          <div class="empty">
            <p class="empty-title">No agents yet</p>
            <p class="meta">Run this on each machine you want to back up:</p>
            <pre translate="no"><code>docker compose -f docker-compose.agent.yml up -d</code></pre>
          </div>
        </div>

        <div class="layer" data-layer="1">
          <div class="bar"><span class="title">Agents</span><span class="meta">1 agent</span></div>
          <table>
            <thead><tr><th>Name</th><th>OS / Arch</th><th>Version</th><th>Status</th></tr></thead>
            <tbody>
              <tr>
                <td>web-01</td><td>linux / amd64</td><td>v0.9.0</td>
                <td><span class="chip connecting">Connecting…</span><span class="chip online">Online</span></td>
              </tr>
            </tbody>
          </table>
          <p class="route"><span>web-01</span><span class="arrow" aria-hidden="true">→</span><span>server :9090</span><span class="meta">gRPC · mTLS · outbound only</span></p>
        </div>

        <div class="layer" data-layer="2">
          <div class="bar"><span class="title">Agents</span><span class="meta">4 online</span></div>
          <table>
            <thead><tr><th>Name</th><th>OS / Arch</th><th>Version</th><th>Status</th></tr></thead>
            <tbody>
              {agents.map((a) => (
                <tr><td>{a.name}</td><td>{a.os}</td><td>v0.9.0</td><td><span class="chip online static">Online</span></td></tr>
              ))}
            </tbody>
          </table>
          <div class="job">
            <p><strong>Backup running</strong> · Postgres on db-01</p>
            <div class="progress" role="img" aria-label="42 percent"><span style="width: 42%"></span></div>
            <p class="meta">42% · 7.6 of 18.0 MiB · NAS (local)</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .how {
    margin-top: var(--section-gap);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-6);
  }
  h2 { grid-column: 1 / span 5; grid-row: 1; }
  .statements { grid-column: 1 / span 5; grid-row: 2; }
  .stage-wrap { grid-column: 7 / span 6; grid-row: 1 / span 2; }
  h2 { font-size: var(--step-h2); }
  article { min-height: 80vh; display: flex; flex-direction: column; justify-content: center; gap: var(--space-3); color: var(--muted); transition: color 300ms ease; }
  article h3 { font-size: var(--step-lead); font-weight: 500; letter-spacing: -0.015em; line-height: 1.2; }
  article p { font-size: var(--step-body); max-width: 40ch; }
  article.is-active { color: var(--ink); }
  :global(html:not(.js)) article { color: var(--ink); min-height: 0; padding-block: var(--space-8); }

  .stage {
    position: sticky; top: 14vh;
    background: var(--surface-strong); border-radius: var(--radius-lg);
    padding: var(--space-7);
    max-width: 580px;
  }
  .agents { position: relative; display: grid; font-size: 14px; }
  .layer {
    background: var(--surface-card); border: 1px solid var(--hairline-strong); border-radius: var(--radius-lg);
    padding: var(--space-5); display: grid; gap: var(--space-4); align-content: start;
  }
  /* With JS, the three states share one spot and cross-fade; without it they stack. */
  :global(.js) .agents { grid-template-areas: 'stack'; }
  :global(.js) .layer { grid-area: stack; opacity: 0; transform: translateY(8px); transition: opacity 300ms ease, transform 300ms ease; pointer-events: none; }
  :global(.js) [data-state='0'] [data-layer='0'],
  :global(.js) [data-state='1'] [data-layer='1'],
  :global(.js) [data-state='2'] [data-layer='2'] { opacity: 1; transform: none; pointer-events: auto; }
  :global(html:not(.js)) .agents { gap: var(--space-4); }
  :global(html:not(.js)) .stage { position: static; }

  .bar { display: flex; justify-content: space-between; align-items: baseline; }
  .title { font-size: 15px; font-weight: 600; }
  .meta { color: var(--muted); font-size: 13px; }
  .empty { display: grid; gap: var(--space-2); padding: var(--space-6) 0; justify-items: start; }
  .empty-title { font-weight: 600; font-size: 15px; }
  pre { margin: var(--space-2) 0 0; padding: var(--space-3) var(--space-4); background: var(--surface-dark); color: var(--on-dark); border-radius: var(--radius-md); font-size: 13px; overflow-x: auto; max-width: 100%; }
  :global([data-theme='dark']) pre { background: var(--canvas); }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th { text-align: left; font-weight: 500; color: var(--muted); font-size: 13px; padding: 0 0 var(--space-2); }
  td { padding: var(--space-2) 0; border-top: 1px solid var(--hairline); white-space: nowrap; }
  td:first-child { font-weight: 600; }
  .chip { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; }
  .chip::before { content: ''; width: 6px; height: 6px; border-radius: 50%; }
  .connecting::before { background: var(--warning); }
  .online::before { background: var(--success); }
  .online:not(.static) { display: none; }
  :global(.js) [data-state='1'] .connecting { animation: hide 0s 1.1s forwards; }
  :global(.js) [data-state='1'] .online:not(.static) { display: inline-flex; opacity: 0; width: 0; overflow: hidden; animation: show 0s 1.1s forwards; }
  @keyframes hide { to { display: none; } }
  @keyframes show { to { opacity: 1; width: auto; } }
  .route { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); font-size: 14px; }
  .arrow { color: var(--brand); font-weight: 600; }
  .job { display: grid; gap: var(--space-2); padding-top: var(--space-2); }
  .progress { height: 6px; background: var(--surface-muted); border-radius: 3px; overflow: hidden; }
  .progress span { display: block; height: 100%; background: var(--brand); }

  @media (max-width: 900px) {
    .how { display: flex; flex-direction: column; }
    .stage-wrap { order: -1; position: sticky; top: 0; z-index: 1; margin-inline: calc(-1 * var(--margin)); }
    h2 { order: -2; margin-bottom: var(--space-6); }
    .stage { top: 0; border-radius: 0; padding: var(--space-4) var(--margin); max-width: none; height: 46svh; overflow: hidden; }
    /* The sticky stage covers the top half; keep each statement in the lower half. */
    article { min-height: 60svh; justify-content: flex-end; padding-bottom: 8svh; }
    article h3 { font-size: 22px; }
    th:nth-child(3), td:nth-child(3) { display: none; }
    :global(html:not(.js)) .stage-wrap { position: static; }
    :global(html:not(.js)) .stage { height: auto; }
  }
</style>

<script>
  import '../../scripts/pinned-stage.ts';
</script>
