---
import { Image } from 'astro:assets';

interface Props {
  name: string;
  alt: string;
  /** Region to show, in interface pixels of the 1440×900 capture. */
  crop: { x: number; y: number; w: number; h: number };
}
const { name, alt, crop } = Astro.props;
const BASE_W = 1440;
const BASE_H = 900;
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/screens/*.png', { eager: true });
const light = images[`../../assets/screens/${name}-light.png`]?.default;
const dark = images[`../../assets/screens/${name}-dark.png`]?.default;
if (!light || !dark) throw new Error(`Missing screenshot pair for "${name}". Run scripts/screenshots.`);

// The image is scaled so the crop rectangle fills the box; the box keeps the crop's aspect ratio.
const style = [
  `aspect-ratio: ${crop.w} / ${crop.h}`,
  `--img-w: ${(BASE_W / crop.w) * 100}%`,
  `--img-h: ${(BASE_H / crop.h) * 100}%`,
  `--img-x: ${(-crop.x / crop.w) * 100}%`,
  `--img-y: ${(-crop.y / crop.h) * 100}%`,
  `--crop-w: ${crop.w}px`,
].join('; ');
---
<div class="crop" data-ui style={style}>
  <Image src={light} alt={alt} width={1440} densities={[1, 2]} data-theme-img="light" loading="lazy" />
  <Image src={dark} alt={alt} width={1440} densities={[1, 2]} data-theme-img="dark" loading="lazy" />
</div>

<style>
  .crop { position: relative; overflow: hidden; width: 100%; }
  .crop img {
    position: absolute; max-width: none;
    width: var(--img-w); height: var(--img-h); left: var(--img-x); top: var(--img-y);
  }
  /* On phones the crop keeps true size and runs off the cell edge instead of shrinking. */
  @media (max-width: 700px) {
    .crop { width: var(--crop-w); flex: none; }
  }
  [data-theme-img='dark'] { display: none; }
  :global([data-theme='dark']) [data-theme-img='light'] { display: none; }
  :global([data-theme='dark']) [data-theme-img='dark'] { display: block; }
</style>
