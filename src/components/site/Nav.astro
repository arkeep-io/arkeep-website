---
import { Image } from 'astro:assets';
import mark from '../../assets/arkeep-mark.png';
import ThemeToggle from './ThemeToggle.astro';
import NewTabIcon from './NewTabIcon.astro';
import Icon from './Icon.astro';
import { GET_STARTED_URL, GITHUB_URL, isDocs, navLinks, tabAttrs } from './links';
import { formatStars } from '../../lib/release';
import { repoStars } from '../../lib/github-build';

const stars = await repoStars();
const starLabel = stars === null ? 'Arkeep on GitHub' : `Arkeep on GitHub, ${stars.toLocaleString('en')} stars`;
---
<nav class="nav wrap" aria-label="Main">
  <a class="wordmark" href="/">
    <Image src={mark} alt="Arkeep" width={28} height={28} loading="eager" />
    <span aria-hidden="true">Arkeep</span>
  </a>
  <ul class="links" id="nav-links">
    {navLinks.map((l) => (
      <li><a href={l.href} {...tabAttrs(l.href)}>{l.label}{isDocs(l.href) && <NewTabIcon />}</a></li>
    ))}
  </ul>
  <div class="actions">
    <a class="github" href={GITHUB_URL} {...tabAttrs(GITHUB_URL)} aria-label={starLabel} data-gh-stars-label>
      <Icon name="github" size={18} />
      <span class="count" aria-hidden="true" data-gh-stars>{stars === null ? '' : formatStars(stars)}</span>
    </a>
    <ThemeToggle />
    <a class="button install" href={GET_STARTED_URL} {...tabAttrs(GET_STARTED_URL)}>Install Arkeep<NewTabIcon /></a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="nav-links" data-menu>
      <span class="visually-hidden">Menu</span>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path class="bar-top" d="M4 8h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /><path class="bar-bottom" d="M4 16h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>
  </div>
</nav>

<style>
  .nav { display: flex; align-items: center; gap: var(--space-xl); height: 64px; }
  .wordmark { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 17px; letter-spacing: -0.01em; text-decoration: none; flex: none; }
  .wordmark img { width: 28px; height: 28px; border-radius: var(--radius-sm); }
  .links { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .links a {
    display: inline-flex; align-items: center; min-height: 36px; white-space: nowrap; padding: 0 var(--space-sm);
    border-radius: var(--radius-md); color: var(--body); font-size: 14px; font-weight: 500; text-decoration: none;
    transition: color 160ms ease, background-color 160ms ease;
  }
  .links a:hover { color: var(--ink); background: var(--hairline-soft); }
  /* GitHub sits as an icon in the actions on desktop. */
  .links li:last-child { display: none; }
  .actions { display: flex; align-items: center; gap: var(--space-xxs); margin-left: auto; }
  .github, .menu {
    display: inline-grid; place-items: center; width: 40px; height: 40px; border: 0; border-radius: var(--radius-md);
    background: transparent; color: var(--ink); cursor: pointer; transition: background-color 160ms ease;
  }
  .github:hover, .menu:hover { background: var(--hairline-soft); }
  .github:has(.count:not(:empty)) { display: inline-flex; gap: 6px; width: auto; padding: 0 10px; font-size: 14px; font-weight: 500; text-decoration: none; color: var(--body); }
  .github:has(.count:not(:empty)):hover { color: var(--ink); }
  .github :global(svg) { color: var(--ink); }
  .count { font-variant-numeric: tabular-nums; }
  .count:empty { display: none; }
  .install { margin-left: var(--space-xs); }
  .menu { display: none; }

  @media (max-width: 1023px) {
    .nav { gap: var(--space-sm); position: relative; }
    .github { display: none; }
    .menu { display: inline-grid; }
    .install { padding-inline: 14px; }
    /* Install first, then the theme switch, then the menu. */
    .install { order: 1; margin-left: 0; }
    .actions > :global(.theme-toggle) { order: 2; }
    .menu { order: 3; }
    /* The menu drops in and out: hidden with visibility (out of the tab order and the a11y tree)
       only after the fade has finished. */
    .links {
      display: flex; position: absolute; top: 64px; left: var(--gutter); right: var(--gutter); z-index: 20;
      flex-direction: column; padding: var(--space-xs); gap: 0;
      background: var(--surface-card); border: 1px solid var(--hairline-strong); border-radius: var(--radius-lg);
      box-shadow: var(--shadow-soft);
      opacity: 0; visibility: hidden; transform: translateY(-8px) scale(0.98); transform-origin: top right;
      transition: opacity 180ms ease, transform 220ms cubic-bezier(.2,.7,.2,1), visibility 0s linear 220ms;
    }
    .links.open {
      opacity: 1; visibility: visible; transform: none;
      transition: opacity 180ms ease, transform 220ms cubic-bezier(.2,.7,.2,1), visibility 0s;
    }
    /* Two bars fold into an X while the menu is open. */
    .menu svg path { transition: transform 220ms cubic-bezier(.2,.7,.2,1); transform-origin: center; transform-box: fill-box; }
    .menu[aria-expanded='true'] .bar-top { transform: translateY(4px) rotate(45deg); }
    .menu[aria-expanded='true'] .bar-bottom { transform: translateY(-4px) rotate(-45deg); }
    .links li:last-child { display: block; }
    .links a { width: 100%; min-height: 44px; font-size: 15px; color: var(--ink); }
  }
  /* Phones: the wordmark stays; the hero's own Install button is right below, so the nav drops it. */
  @media (max-width: 639px) {
    .install { display: none; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu]');
  const list = document.getElementById('nav-links');
  if (btn && list) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      list.classList.toggle('open', open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    list.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    document.addEventListener('click', (e) => { if (!(e.target as Element).closest('.nav')) set(false); });
  }
</script>
