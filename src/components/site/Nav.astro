---
import { Image } from 'astro:assets';
import mark from '../../assets/arkeep-mark.png';
import ThemeToggle from './ThemeToggle.astro';
import NewTabIcon from './NewTabIcon.astro';
import { GET_STARTED_URL, isDocs, navLinks, tabAttrs } from './links';
---
<nav class="nav" aria-label="Main">
  <a class="wordmark" href="/">
    <Image src={mark} alt="" width={32} height={32} loading="eager" />
    <span>Arkeep</span>
  </a>
  <ul class="links">
    {navLinks.map((l) => <li><a href={l.href} {...tabAttrs(l.href)}>{l.label}{isDocs(l.href) && <NewTabIcon />}</a></li>)}
  </ul>
  <div class="actions">
    <ThemeToggle />
    <a class="button" href={GET_STARTED_URL} {...tabAttrs(GET_STARTED_URL)}>Install Arkeep<NewTabIcon /></a>
  </div>
</nav>

<style>
  .nav { display: flex; align-items: center; gap: var(--space-6); min-height: 72px; }
  .wordmark { display: inline-flex; align-items: center; gap: var(--space-3); font-weight: 600; font-size: var(--step-body); letter-spacing: -0.01em; text-decoration: none; }
  .wordmark img { width: 32px; height: 32px; border-radius: var(--radius-md); }
  .links { display: flex; gap: var(--space-2); list-style: none; margin: 0 0 0 auto; padding: 0; }
  .links a { color: var(--ink); display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--space-3); border-radius: var(--radius-md); font-size: var(--step-small); font-weight: 500; text-decoration: none; transition: background-color 160ms ease; }
  .links a:hover { background: var(--surface-muted); }
  .actions { display: flex; align-items: center; gap: var(--space-2); }
  @media (max-width: 720px) {
    .nav { gap: var(--space-3); }
    .links li:nth-child(2) { display: none; }
    .links { gap: 0; }
    .links a { padding: 0 var(--space-2); }
    .actions .button { padding: 0 var(--space-3); }
  }
  @media (max-width: 420px) {
    .links li:nth-child(3) { display: none; }
    .wordmark span { display: none; }
  }
</style>
