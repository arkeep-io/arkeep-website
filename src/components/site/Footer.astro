---
import { Image } from 'astro:assets';
import mark from '../../assets/arkeep-mark.png';
import { getLatestRelease } from '../../lib/release';
import NewTabIcon from './NewTabIcon.astro';
import Icon from './Icon.astro';
import { DISCUSSIONS_URL, DOCKER_HUB_URL, GITHUB_URL, ISSUES_URL, RELEASES_URL, SPONSORS_URL, isDocs, tabAttrs } from './links';

const release = await getLatestRelease();
const year = new Date().getFullYear();
const releaseDate = release
  ? new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(`${release.date}T00:00:00Z`))
  : null;

const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Features', href: '/#features' },
      { label: 'How it works', href: '/#how-it-works' },
      { label: 'Retention', href: '/#retention' },
      { label: 'Roadmap', href: '/#roadmap' },
      { label: 'Install', href: '/#install' },
    ],
  },
  {
    title: 'Docs',
    links: [
      { label: 'Quickstart', href: '/docs/quickstart/' },
      { label: 'Installation', href: '/docs/installation/docker-compose/' },
      { label: 'Policies', href: '/docs/guides/policies/' },
      { label: 'Architecture', href: '/docs/concepts/architecture/' },
      { label: 'FAQ', href: '/docs/reference/faq/' },
    ],
  },
  {
    title: 'Community',
    links: [
      { label: 'GitHub', href: GITHUB_URL },
      { label: 'Discussions', href: DISCUSSIONS_URL },
      { label: 'Open an issue', href: ISSUES_URL },
      { label: 'Contributing', href: '/docs/contributing/' },
    ],
  },
  {
    title: 'Downloads',
    links: [
      { label: 'Releases', href: RELEASES_URL },
      { label: 'Docker Hub', href: DOCKER_HUB_URL },
      { label: 'Helm chart', href: '/docs/installation/kubernetes/' },
    ],
  },
];
---
<footer class="footer" aria-labelledby="footer-title">
  <div class="wrap">
    <h2 id="footer-title" class="visually-hidden">Arkeep project</h2>
    <div class="grid">
      <div class="brand">
        <a class="wordmark" href="/"><Image src={mark} alt="" width={32} height={32} /><span>Arkeep</span></a>
        <p class="statement">Your infra’s Ark. Back up everything, keep it yours.</p>
        <p class="release">
          {release ? (
            <a href={release.url} {...tabAttrs(release.url)}><span class="badge badge--accent">{release.tag}</span><span>Latest release · <time datetime={release.date}>{releaseDate}</time></span></a>
          ) : (
            <a href={RELEASES_URL} {...tabAttrs(RELEASES_URL)}>All releases</a>
          )}
        </p>
        <a class="button button--secondary sponsor" href={SPONSORS_URL} {...tabAttrs(SPONSORS_URL)}><Icon name="heart" />Sponsor the work</a>
      </div>
      {columns.map((c) => (
        <nav class="col" aria-label={c.title}>
          <h3>{c.title}</h3>
          <ul>
            {c.links.map((l) => (
              <li><a href={l.href} {...tabAttrs(l.href)}>{l.label}{isDocs(l.href) && <NewTabIcon />}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="bottom">
      <p>© {year} Arkeep contributors · Apache-2.0</p>
    </div>
  </div>
</footer>

<style>
  .footer { margin-top: var(--space-xxl); padding: 64px 0 var(--space-xxl); background: var(--canvas); border-top: 1px solid var(--hairline); }
  .grid { display: grid; grid-template-columns: minmax(0, 1.6fr) repeat(4, minmax(0, 1fr)); gap: var(--space-xl); }
  .brand { display: grid; gap: var(--space-base); align-content: start; justify-items: start; }
  .wordmark { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 18px; text-decoration: none; }
  .wordmark img { width: 32px; height: 32px; border-radius: var(--radius-sm); }
  .statement { color: var(--body); font-size: 14px; max-width: 28ch; }
  .release a { display: inline-flex; align-items: center; gap: var(--space-xs); color: var(--body); font-size: 13px; text-decoration: none; }
  .release a:hover { color: var(--ink); }
  .release .badge { text-transform: none; letter-spacing: 0.02em; font-size: 12px; }
  .sponsor svg { color: var(--brand); }
  h3 { font-size: 14px; font-weight: 600; margin-bottom: var(--space-base); }
  .col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .col a { color: var(--body); font-size: 14px; text-decoration: none; transition: color 160ms ease; }
  .col a:hover { color: var(--ink); }
  .bottom { margin-top: var(--space-xxl); padding-top: var(--space-lg); border-top: 1px solid var(--hairline); display: flex; justify-content: space-between; gap: var(--space-base); flex-wrap: wrap; font-size: 13px; color: var(--body); }

  @media (max-width: 1023px) {
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .brand { grid-column: 1 / -1; }
  }
  @media (max-width: 639px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--space-xl); }
    .col a { display: inline-flex; min-height: 40px; align-items: center; }
    .col ul { gap: 0; }
  }
</style>
