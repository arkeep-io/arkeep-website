---
// Marks a link that opens in a new tab: a small arrow, plus text for screen readers.
---
<span class="new-tab" data-new-tab-icon>
  <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
  <span class="visually-hidden">(opens in a new tab)</span>
</span>

<style>
  .new-tab { display: inline-flex; vertical-align: middle; margin-left: 0.25em; }
  .new-tab svg { width: 0.8em; height: 0.8em; transition: transform 160ms ease; }
  /* Buttons already space their children with gap. */
  :global(.button) > .new-tab, :global(button) > .new-tab { margin-left: 0; }
  :global(a:hover) > .new-tab svg { transform: translate(1px, -1px); }
</style>
